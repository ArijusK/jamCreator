@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using JamCreator.Shared.Models.DTOs
@inject HttpClient Http


<div class="chat-panel">
    <!-- Header -->
    <div class="chat-header">
        <h2>Chat</h2>
        <div class="name-pill">@Name</div>
    </div>

    <!-- Scroll’inama žinučių zona -->
    <div id="chatScroll" class="chat-messages">
        @if (Messages.Count == 0)
        {
            <div class="empty">No messages yet.</div>
        }
        else
        {
            @foreach (var m in Messages)
            {
                <div class="msg @(m.User == Name ? "mine" : "theirs")">
                    <div class="meta">
                        <span class="user">
                            @if (!string.IsNullOrEmpty(m.Avatar))
                            {
                                <span class="avatar" style="font-size:20px;margin-right:4px;">@m.Avatar</span>
                            }
                            @m.User
                        </span>
                        <span class="time">@m.TimestampLocal.ToString("HH:mm")</span>
                    </div>
                    <div class="bubble">@m.Text</div>
                </div>
            }
        }
    </div>

    <!-- Fiksuota input juosta apačioje -->
    <div class="chat-inputbar">
        <input @ref="messageInputRef"
               id="messageInput"
               type="text"
               class="chat-input"
               placeholder="Message..."
               @bind="Message"
               @bind:event="oninput"
               @onkeydown="HandleEnter" />

        <button type="button"
                class="btn-send"
                @onclick="Send"
                disabled="@string.IsNullOrWhiteSpace(Message)">
            <i class="bi bi-send-fill"></i>
        </button>
    </div>
</div>

@code {
    [Parameter]
    public string SessionId { get; set; } = "";

    private HubConnection? hubConnection;
    private List<ChatMsg> Messages = new();

    private string Name = "Guest";
    private string? Message;
    private string? Avatar = "😎";

    private ElementReference messageInputRef;

    public record ChatMsg(string User, string Text, DateTime TimestampLocal, string Avatar);

    protected override async Task OnInitializedAsync()
    {
        var storedName = await JS.InvokeAsync<string>("localStorage.getItem", "chat.username");
        var storedAvatar = await JS.InvokeAsync<string>("localStorage.getItem", "avatar");

        if (!string.IsNullOrWhiteSpace(storedName)) Name = storedName;
        if (!string.IsNullOrWhiteSpace(storedAvatar)) Avatar = storedAvatar;

        await LoadHistory();

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/chathub"))
            .Build();

        hubConnection.On<string, string, string?, DateTime>(
            "ReceiveMessage",
            (user, text, avatar, sentAtUtc) =>
            {
                var localTime = sentAtUtc.ToLocalTime();
                Messages.Add(new ChatMsg(user, text, localTime, avatar ?? ""));
                InvokeAsync(StateHasChanged);
                JS.InvokeVoidAsync("chatHelpers.scrollToBottom", "chatScroll");
            });

        await hubConnection.StartAsync();

        if (!string.IsNullOrEmpty(SessionId))
        {
            await hubConnection.InvokeAsync("JoinSession", SessionId);
        }
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(Message) || hubConnection is null)
            return;

        var text = Message.Trim();
        if (text.Length == 0)
            return;

        var user = Name;
        var avatar = Avatar ?? "";

        Message = string.Empty;
        await JS.InvokeVoidAsync("chatHelpers.focus", "messageInput");

        await hubConnection.SendAsync("SendMessage", user, text, avatar, SessionId);
    }

    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Send();
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
            await hubConnection.DisposeAsync();
    }

    private async Task LoadHistory()
    {
        if (string.IsNullOrWhiteSpace(SessionId))
            return;

        try
        {
            var history = await Http.GetFromJsonAsync<List<ChatHistoryDto>>(
                $"/api/chat/{SessionId}?take=50");

            if (history is { Count: > 0 })
            {
                Messages = history
                    .Select(h => new ChatMsg(
                        h.User,
                        h.Text,
                        h.SentAtUtc.ToLocalTime(),
                        h.Avatar ?? ""
                    ))
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Failed to load chat history: " + ex.Message);
        }
    }

}
