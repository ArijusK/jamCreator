@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="chat-shell">
    <div class="chat-header">
        <h2>Chat</h2>
        <div class="name-pill">@Name</div>
    </div>

    <div id="chatScroll" class="chat-messages">
        @if (Messages.Count == 0)
        {
            <div class="empty">No messages yet.</div>
        }
        else
        {
            @foreach (var m in Messages)
            {
                <div class="msg @(m.User == Name ? "mine" : "theirs")">
                    <div class="meta">
                        <span class="user">
                            @if (!string.IsNullOrEmpty(m.Avatar))
                            {
                                <span class="avatar" style="font-size:20px;margin-right:4px;">@m.Avatar</span>
                            }
                            @m.User
                        </span>
                        <span class="time">@m.Timestamp.ToString("HH:mm")</span>
                    </div>
                    <div class="bubble">@m.Text</div>
                </div>
            }
        }
    </div>

    <div class="chat-inputbar">
        <input @ref="messageInputRef"
               id="messageInput"
               type="text"
               placeholder="Message..."
               @bind="Message"
               @bind:event="oninput"
               @onkeydown="HandleEnter" />
        
        <button class="btn-send" @onclick="Send">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
        </button>
    </div>
</div>

@code {
    [Parameter]
    public string SessionId { get; set; } = "";

    private HubConnection? hubConnection;
    private List<ChatMsg> Messages = new();
    
    private string Name = "Guest"; 
    private string? Message;
    private string? Avatar = "😎"; 
    
    private ElementReference messageInputRef;

    public record ChatMsg(string User, string Text, DateTime Timestamp, string Avatar);

    protected override async Task OnInitializedAsync()
    {
        var storedName = await JS.InvokeAsync<string>("localStorage.getItem", "chat.username");
        var storedAvatar = await JS.InvokeAsync<string>("localStorage.getItem", "avatar");

        if (!string.IsNullOrWhiteSpace(storedName)) Name = storedName;
        if (!string.IsNullOrWhiteSpace(storedAvatar)) Avatar = storedAvatar;

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/chathub"))
            .Build();

        hubConnection.On<string, string, string>("ReceiveMessage", (user, message, avatar) =>
        {
            Messages.Add(new ChatMsg(user, message, DateTime.Now, avatar));
            StateHasChanged();
            JS.InvokeVoidAsync("chatHelpers.scrollToBottom", "chatScroll");
        });

        await hubConnection.StartAsync();

        if (!string.IsNullOrEmpty(SessionId))
        {
            await hubConnection.InvokeAsync("JoinSession", SessionId);
        }
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(Message))
            return;

        var text = Message.Trim();
        var user = Name;
        var avatar = Avatar ?? "";
        
        Message = string.Empty;

        await JS.InvokeVoidAsync("chatHelpers.focus", "messageInput");

        if (hubConnection is not null)
        {
            await hubConnection.SendAsync("SendMessage", user, text, avatar, SessionId);
        }
    }

    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Send();
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}