@rendermode InteractiveWebAssembly
@page "/chat"

@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Web
@using JamCreator.Shared.Models.DTOs
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject HttpClient Http

<div class="chat-shell">
  <div class="chat-header">
    <h2>Chat</h2>
    <div class="spacer"></div>
    @if (NameLocked)
    {
      <div class="name-pill" title="Click to change" @onclick="UnlockName">@Name</div>
    }
  </div>

  <div id="chatScroll" class="chat-messages">
    @if (Messages.Count == 0)
    {
      <div class="empty">No messages yet. Be the first to say hi 👋</div>
    }
    else
    {
      @foreach (var m in Messages)
      {
        <div class="msg @(m.User == Name ? "mine" : "theirs")">
          <div class="meta">
            <span class="user">
              @if (!string.IsNullOrEmpty(m.Avatar))
              {
                <span class="avatar" style="font-size:20px;margin-right:4px;">@m.Avatar</span>
              }
              @m.User
            </span>
            <span class="time">@m.Timestamp.ToString("HH:mm")</span>
          </div>
          <div class="bubble">@m.Text</div>
        </div>
      }
    }
  </div>

  <div class="chat-inputbar">
    <input id="nameInput"
           class="name"
           placeholder="Your name"
           @bind="Name"
           @bind:event="oninput"
           disabled="@NameLocked" />

    <input id="messageInput"
           class="message"
           placeholder="Type a message…"
           @bind="Message"
           @bind:event="oninput"
           @onkeydown="HandleEnter" />

    <button class="send" @onclick="Send" disabled="@IsSendDisabled">Send</button>
  </div>
</div>

@code {
    private HubConnection? hubConnection;
    private bool _handlerRegistered;

    private string? Name { get; set; }
    private bool NameLocked { get; set; }
    private string? Message { get; set; }
    private string? Avatar { get; set; }
    private readonly List<ChatMsg> Messages = new();
    private bool IsSendDisabled => string.IsNullOrWhiteSpace(Message);

    protected override async Task OnInitializedAsync()
    {
        hubConnection ??= new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/chathub"))
            .WithAutomaticReconnect()
            .Build();

        // Ensure we don't double-register (prevents duplicate messages)
        if (!_handlerRegistered)
        {
            hubConnection.Remove("ReceiveMessage");
            hubConnection.On<string, string, string, DateTime>(
                "ReceiveMessage",
                (user, text, avatar, sentAtUtc) =>
                {
                    // These are messages from OTHER users only (hub sends to Others)
                    Messages.Add(new ChatMsg(user, text, sentAtUtc.ToLocalTime(), avatar));
                    _ = InvokeAsync(async () =>
                    {
                        StateHasChanged();
                        await JS.InvokeVoidAsync("chatHelpers.scrollToBottom", "chatScroll");
                    });
                });

            _handlerRegistered = true;
        }

        if (hubConnection.State == HubConnectionState.Disconnected)
            await hubConnection.StartAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Restore local name/avatar
        var storedName = await JS.InvokeAsync<string>("localStorage.getItem", "chat.username");
        if (!string.IsNullOrWhiteSpace(storedName))
        {
            Name = storedName;
            NameLocked = true;
        }

        var storedAvatar = await JS.InvokeAsync<string>("localStorage.getItem", "avatar");
        if (!string.IsNullOrWhiteSpace(storedAvatar))
        {
            Avatar = storedAvatar;
        }

        // Load recent history (server returns ascending after reverse)
        try
        {
            var history = await Http.GetFromJsonAsync<List<ChatMessageDto>>("/api/chat/history?take=50");
            if (history is not null)
            {
                foreach (var h in history)
                    Messages.Add(new ChatMsg(h.User, h.Text, h.SentAtUtc.ToLocalTime(), h.Avatar));
            }
        }
        catch
        {
            // ignore history load errors in UI
        }

        StateHasChanged();
        await JS.InvokeVoidAsync("chatHelpers.focus", "messageInput");
        await JS.InvokeVoidAsync("chatHelpers.scrollToBottom", "chatScroll");
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(Message))
            return;

        if (!NameLocked)
        {
            Name = string.IsNullOrWhiteSpace(Name) ? "Guest" : Name!.Trim();
            NameLocked = true;
            await JS.InvokeVoidAsync("localStorage.setItem", "chat.username", Name);
            StateHasChanged();
        }

        var text = Message!.Trim();
        var user = Name!;
        var avatar = Avatar ?? "";

        // ✅ Local echo (sender sees the message immediately)
        Messages.Add(new ChatMsg(user, text, DateTime.Now, avatar));
        Message = string.Empty;

        await JS.InvokeVoidAsync("chatHelpers.scrollToBottom", "chatScroll");
        await JS.InvokeVoidAsync("chatHelpers.focus", "messageInput");

        if (hubConnection is not null)
            await hubConnection.SendAsync("SendMessage", user, text, avatar);
    }

    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !IsSendDisabled)
            await Send();
    }

    private void UnlockName()
    {
        NameLocked = false;
        _ = JS.InvokeVoidAsync("chatHelpers.focus", "nameInput");
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
            await hubConnection.DisposeAsync();
    }

    private record ChatMsg(string User, string Text, DateTime Timestamp, string? Avatar);
}
