@page "/create-jam"
@rendermode InteractiveWebAssembly
@using System.ComponentModel.DataAnnotations
@using JamCreator.Shared.Models
@inject ILogger<CreateJam> Logger
@inject HttpClient Http
@inject NavigationManager Nav

<h3>Create Jam Page</h3>

@if (!string.IsNullOrWhiteSpace(GreetingMessage))
{
    <div class="alert alert-success" role="alert">
        @GreetingMessage
    </div>
}

<EditForm Model="Model" OnSubmit="Submit" FormName="CreateJamRoom">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>Room name:</label>
        <InputText @bind-Value="Model!.RoomName" class="form-control" />
        <ValidationMessage For="() => Model!.RoomName" />
    </div>

    <div class="form-group">
        <label>Max people</label>
        <InputSelect @bind-Value="Model!.MaxPeople" class="form-control" TValue="int?">
            <option value="">Select</option>
            @foreach (var n in PeopleOptions)
            {
                <option value="@n">@n</option>
            }
        </InputSelect>
        <ValidationMessage For="() => Model!.MaxPeople" />
    </div>

    <div class="form-group">
        <label>Genre</label>
        <InputText @bind-Value="Model!.Genre" class="form-control" placeholder="e.g., Jazz, Rock, EDM" />
        <ValidationMessage For="() => Model!.Genre" />
    </div>

    <div class="form-group">
        <label>Description</label>
        <InputTextArea @bind-Value="Model!.Description" class="form-control" rows="3" />
        <ValidationMessage For="() => Model!.Description" />
    </div>

    <div class="form-group">
        <label>Visibility</label>
        <InputSelect @bind-Value="Model!.IsPrivate" class="form-control" TValue="bool">
            <option value="false">Public</option>
            <option value="true">Private</option>
        </InputSelect>
        <ValidationMessage For="() => Model!.IsPrivate" />
    </div>

    @if (Model?.IsPrivate == true)
    {
        <div class="form-group">
            <label>Password</label>
            <InputText @bind-Value="Model!.Password" class="form-control" type="password" />
            <ValidationMessage For="() => Model!.Password" />
        </div>
    }

    <div class="form-group">
        <label>Mood</label>
        <!-- bind as string to avoid enum conversion issues -->
        <InputSelect @bind-Value="SelectedMood" class="form-control" TValue="string">
            @foreach (var m in MoodOptions)
            {
                <option value="@m.ToString()">@m.ToString()</option>
            }
        </InputSelect>
        <ValidationMessage For="() => Model!.Mood" />
    </div>

    <div class="form-group">
        <label>Duration</label>
        <InputSelect @bind-Value="Model!.DurationMinutes" class="form-control" TValue="int">
            @foreach (var d in DurationOptions)
            {
                <option value="@d">@d min</option>
            }
        </InputSelect>
        <ValidationMessage For="() => Model!.DurationMinutes" />
    </div>

    <div class="form-group">
        <InputCheckbox @bind-Value="Model!.AllowSkipVote" />
        <label>Allow song skip voting</label>
    </div>

    <div style="margin-top:1rem">
        <button type="submit">Create</button>
    </div>
</EditForm>

@code {
    private readonly int[] PeopleOptions = { 1, 2, 3, 4 };

    private readonly JamMood[] MoodOptions =
    {
        JamMood.Chill,
        JamMood.Rock,
        JamMood.Jazz,
        JamMood.Blues,
        JamMood.Funk,
        JamMood.Classical
    };

    private readonly int[] DurationOptions = { 15, 30, 60, 90, 120 };
    private JamCreateModel Model = new();
    private string GreetingMessage = string.Empty;

    private string SelectedMood
    {
        get => Model.Mood.ToString();
        set
        {
            if (Enum.TryParse<JamMood>(value, out var moodResult))
            {
                Model.Mood = moodResult;
            }
        }
    }

    private string Greet(string name = "Guest", string prefix = "Welcome")
    {
        return $"{prefix}, {name}! Thanks for creating a jam.";
    }

    private async Task Submit()
    {
        var response = await Http.PostAsJsonAsync("/api/sessions/create-jam", Model);

        if (response.IsSuccessStatusCode)
        {
            GreetingMessage = Greet(name: Model.RoomName ?? "Guest");
            Console.WriteLine(GreetingMessage);
            Nav.NavigateTo("/join-jam");
        }
        else
        {
            var err = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Error: {err}");
        }
    }
}