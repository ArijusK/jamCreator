@page "/create-jam"
@using System.Net.Http.Json
@using JamCreator.Shared.Models
@using JamCreator.Client.Services 
@inject JamSessionService JamSessionService
@inject HttpClient Http
@inject ILogger<CreateJam> Logger
@inject NavigationManager Navigation

<h3>Create Jam</h3>

<EditForm Model="Model" OnValidSubmit="Submit" FormName="CreateJamForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>Room name:</label>
        <InputText @bind-Value="Model!.RoomName" class="form-control"/>
        <ValidationMessage For="() => Model!.RoomName"/>
    </div>

    <div class="form-group">
        <label>Max people</label>
        <InputSelect @bind-Value="Model!.MaxPeople" class="form-control" TValue="int?">
            <option value="">Select</option>
            @foreach (var n in PeopleOptions)
            {
                <option value="@n">@n</option>
            }
        </InputSelect>
        <ValidationMessage For="() => Model!.MaxPeople"/>
    </div>

    <div class="form-group">
        <label>Genre</label>
        <InputText @bind-Value="Model!.Genre" class="form-control" placeholder="e.g., Jazz, Rock, EDM" />
        <ValidationMessage For="() => Model!.Genre" />
    </div>

    <div class="form-group">
        <label>Description</label>
        <InputTextArea @bind-Value="Model!.Description" class="form-control" rows="3" />
        <ValidationMessage For="() => Model!.Description" />
    </div>

    <div class="form-group">
        <label>Visibility</label>
        <InputSelect @bind-Value="Model!.IsPrivate" class="form-control" TValue="bool">
            <option value="false">Public</option>
            <option value="true">Private</option>
        </InputSelect>
        <ValidationMessage For="() => Model!.IsPrivate" />
    </div>

    @if (Model?.IsPrivate == true)
    {
        <div class="form-group">
            <label>Password</label>
            <InputText @bind-Value="Model!.Password" class="form-control" type="password" />
            <ValidationMessage For="() => Model!.Password" />
        </div>
    }

    <div class="form-group">
        <label>Mood</label>
        <InputSelect @bind-Value="Model!.Mood" class="form-control">
            @foreach (var m in MoodOptions)
            {
                <option value="@m">@m</option>
            }
        </InputSelect>
        <ValidationMessage For="() => Model!.Mood" />
    </div>

    <div class="form-group">
        <label>Duration</label>
        <InputSelect @bind-Value="Model!.DurationMinutes" class="form-control" TValue="int">
            @foreach (var d in DurationOptions)
            {
                <option value="@d">@d min</option>
            }
        </InputSelect>
        <ValidationMessage For="() => Model!.DurationMinutes" />
    </div>

    <div class="form-group">
        <InputCheckbox @bind-Value="Model!.AllowSkipVote" />
        <label>Allow song skip voting</label>
    </div>

    <button type="submit" class="btn btn-success mt-2">Create Jam</button>
</EditForm>

@if (CreatedSession != null)
{
    <div class="alert alert-success mt-3">
        <strong>Created Session!</strong><br />
        ID: @CreatedSession.Id<br />
        Room: @CreatedSession.RoomName<br />
        Mood: @CreatedSession.Mood<br />
        MaxPeople: @CreatedSession.MaxPeople<br />
        Genre: @CreatedSession.Genre<br />
        Description: @CreatedSession.Description<br />
        IsPrivate: @CreatedSession.IsPrivate<br />
        Password: @CreatedSession.Password<br />
        DurationMinutes: @CreatedSession.DurationMinutes<br />
        AllowSkipVote: @CreatedSession.AllowSkipVote
    </div>
}

@code {
    private JamCreatorUser Model { get; set; } = new();
    private JamSessionModel? CreatedSession;

    private readonly int[] PeopleOptions = { 2, 3, 4 };
    private readonly string[] MoodOptions = { "Chill", "Energetic", "Groovy", "Ambient" };
    private readonly int[] DurationOptions = { 30, 60, 90, 120 };

    private async Task Submit()
    {
    try
    {
        CreatedSession = await JamSessionService.CreateSessionAsync(Model);
        Logger.LogInformation("Created session {id}", CreatedSession.Id);

      //  Navigation.NavigateTo("/join-jam");
    }
    catch (Exception ex)
    {
        Logger.LogError(ex, "Failed to create session");
    }
    }
}