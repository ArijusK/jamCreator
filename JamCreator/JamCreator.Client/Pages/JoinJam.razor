@page "/join-jam"
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using JamCreator.Shared.Models
@using JamCreator.Shared.Extensions
@inject ILogger<JoinJam> Logger
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="CloseAlert"></button>
    </div>
}

<h3>Join a Jam Session</h3>

@if (isLoading)
{
    <p><em>Loading sessions...</em></p>
}
else if (sessions == null || sessions.Count == 0)
{
    <p>No active jam sessions found. <a href="/create-jam">Create one!</a></p>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Room Name</th>
            <th>Genre</th>
            <th>Mood</th>
            <th>Max People</th>
            <th>Private</th>
            <th>Joinable</th>
            <th>Password</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var session in sessions)
        {
            <tr>
                <td>@session.RoomName</td>
                <td>@session.Genre</td>
                <td>@session.Mood</td>
                <td>@session.MaxPeople</td>
                <td>@(session.IsPrivate ? "Yes" : "No")</td>
                <td>@(session.IsJoinable() ? "Yes" : "No")</td>
                <td>
                    @if (session.IsPrivate)
                    {
                        <input type="password"
                               placeholder="Enter password"
                               @bind="session.TempPassword"
                               class="form-control" />
                    }
                </td>
                <td>
                    <button class="btn btn-primary"
                            disabled="@(isJoining)"
                            @onclick="() => Submit(session)">
                        Join
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<JamSessionModel> sessions = new();
    private bool isLoading = true;
    private bool isJoining = false;
    private string? errorMessage;

    private string? userName;      // vardas tik šitam tabui
    private string? clientToken;   // stabilus ID user'iui (visiems tabams)

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            // 1) ClientToken – stabilus kliento identifikatorius
            clientToken = await JS.InvokeAsync<string>("localStorage.getItem", "jamClientToken");
            if (string.IsNullOrWhiteSpace(clientToken))
            {
                clientToken = Guid.NewGuid().ToString("N");
                await JS.InvokeVoidAsync("localStorage.setItem", "jamClientToken", clientToken);
            }

            // 2) Vardas TIK šiam tabui
            var sessionName = await JS.InvokeAsync<string>("sessionStorage.getItem", "jam.displayName");

            // 3) Profilyje saugomas vardas (bendras visuose tabuose)
            var profileName = await JS.InvokeAsync<string>("localStorage.getItem", "chat.username");
            if (string.IsNullOrWhiteSpace(profileName))
                profileName = "Guest";

            // 4) Jeigu profilio vardas pasikeitė → atnaujinam sessionStorage
            if (string.IsNullOrWhiteSpace(sessionName) || sessionName != profileName)
            {
                userName = profileName;
                await JS.InvokeVoidAsync("sessionStorage.setItem", "jam.displayName", userName);
            }
            else
            {
                userName = sessionName; // naudojam egzistuojantį
            }

            // 5) Užkraunam sesijas
            sessions = await Http.GetFromJsonAsync<List<JamSessionModel>>("/api/sessions/get-sessions")
                    ?? new List<JamSessionModel>();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load sessions");
            errorMessage = "Failed to load sessions. Please try again later.";
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task Submit(JamSessionModel session)
    {
        try
        {
            errorMessage = null;
            isJoining = true;

            // dar kartą pasiimam vardą iš sessionStorage, jei kas pasikeitė šiame tabe
            if (string.IsNullOrWhiteSpace(userName))
            {
                userName = await JS.InvokeAsync<string>("sessionStorage.getItem", "jam.displayName");
                if (string.IsNullOrWhiteSpace(userName))
                    userName = "Guest";
            }

            var joinRequest = new JoinModel
            {
                SessionId   = session.Id!,
                Password    = session.IsPrivate ? session.TempPassword : null,
                DisplayName = userName,
                ClientToken = clientToken   
            };

            var response = await Http.PostAsJsonAsync("/api/sessions/join-jam", joinRequest);

            if (response.IsSuccessStatusCode)
            {
                Logger.LogInformation("Successfully joined session {id}", session.Id);
                Navigation.NavigateTo($"/session/{session.Id}");
            }
            else
            {
                var text = await response.Content.ReadAsStringAsync();

                if (text.Contains("Session is full", StringComparison.OrdinalIgnoreCase))
                    errorMessage = "This session is full. Choose a different one.";
                else if (text.Contains("Incorrect password", StringComparison.OrdinalIgnoreCase))
                    errorMessage = "Incorrect password.";
                else if (text.Contains("display name is already in use", StringComparison.OrdinalIgnoreCase))
                    errorMessage = "This display name is already in use in this session. Choose another name in your profile.";
                else
                    errorMessage = "Failed to join the session.";

                _ = Task.Run(async () =>
                {
                    await Task.Delay(3000);
                    errorMessage = null;
                    await InvokeAsync(StateHasChanged);
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error joining session");
            errorMessage = "Unexpected error occurred while joining.";
        }
        finally
        {
            isJoining = false;
        }
    }

    private void CloseAlert()
    {
        errorMessage = null;
    }
}

