@page "/join-jam"
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using JamCreator.Shared.Models
@using JamCreator.Shared.Extensions
@implements IAsyncDisposable
@inject ILogger<JoinJam> Logger
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="CloseAlert"></button>
    </div>
}

<h3>Join a Jam Session</h3>

@if (isLoading)
{
    <p><em>Loading sessions...</em></p>
}
else if (sessions == null || sessions.Count == 0)
{
    <p>No active jam sessions found. <a href="/create-jam">Create one!</a></p>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Room Name</th>
            <th>Genre</th>
            <th>Mood</th>
            <th>Max People</th>
            <th>Online</th>
            <th>Private</th>
            <th>Joinable</th>
            <th>Password</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var session in sessions)
        {
            <tr>
                <td>@session.RoomName</td>
                <td>@session.Genre</td>
                <td>@session.Mood</td>
                <td>@session.MaxPeople</td>
                <td>
                    <span class="badge bg-success">
                        @(session.Participants?.Count ?? 0)
                    </span>
                </td>
                <td>@(session.IsPrivate ? "Yes" : "No")</td>
                <td>@(session.IsJoinable() ? "Yes" : "No")</td>
                <td>
                    @if (session.IsPrivate)
                    {
                        <input type="password"
                               placeholder="Enter password"
                               @bind="session.TempPassword"
                               class="form-control" />
                    }
                </td>
                <td>
                    <button class="btn btn-primary"
                            disabled="@(isJoining)"
                            @onclick="() => Submit(session)">
                        Join
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<JamSessionModel> sessions = new();
    private bool isLoading = true;
    private bool isJoining = false;
    private string? errorMessage;

    private string? userName;
    private string? clientToken;
    
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            await InitializeUserTokensAsync();
            await LoadSessionsAsync(); 
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load sessions");
            errorMessage = "Failed to load sessions.";
        }
        finally
        {
            isLoading = false;
        }

        _cts = new CancellationTokenSource();
        _ = StartAutoRefreshAsync(_cts.Token);
    }

    private async Task LoadSessionsAsync()
    {
        var result = await Http.GetFromJsonAsync<List<JamSessionModel>>("/api/sessions/get-sessions");
        if (result != null)
        {
            foreach (var newSession in result)
            {
                var existing = sessions.FirstOrDefault(s => s.Id == newSession.Id);
                if (existing != null && !string.IsNullOrEmpty(existing.TempPassword))
                {
                    newSession.TempPassword = existing.TempPassword;
                }
            }
            sessions = result;
        }
    }

    private async Task StartAutoRefreshAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(3000, token);
                await LoadSessionsAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_cts != null)
        {
            _cts.Cancel();
            _cts.Dispose();
            _cts = null;
        }
    }

    private async Task InitializeUserTokensAsync()
    {
        clientToken = await JS.InvokeAsync<string>("localStorage.getItem", "jamClientToken");
        if (string.IsNullOrWhiteSpace(clientToken))
        {
            clientToken = Guid.NewGuid().ToString("N");
            await JS.InvokeVoidAsync("localStorage.setItem", "jamClientToken", clientToken);
        }
        
        var sessionName = await JS.InvokeAsync<string>("sessionStorage.getItem", "jam.displayName");
        var profileName = await JS.InvokeAsync<string>("localStorage.getItem", "chat.username");
        
        if (string.IsNullOrWhiteSpace(profileName)) profileName = "Guest";

        if (string.IsNullOrWhiteSpace(sessionName) || sessionName != profileName)
        {
            userName = profileName;
            await JS.InvokeVoidAsync("sessionStorage.setItem", "jam.displayName", userName);
        }
        else
        {
            userName = sessionName;
        }
    }

    private async Task Submit(JamSessionModel session)
    {
        try
        {
            errorMessage = null;
            try { await JS.InvokeVoidAsync("sessionAudioSync.enableSync"); } catch {}

            isJoining = true;
            
            if (string.IsNullOrWhiteSpace(userName))
            {
                userName = await JS.InvokeAsync<string>("sessionStorage.getItem", "jam.displayName");
                if (string.IsNullOrWhiteSpace(userName)) userName = "Guest";
            }

            var joinRequest = new JoinModel
            {
                SessionId   = session.Id!,
                Password    = session.IsPrivate ? session.TempPassword : null,
                DisplayName = userName,
                ClientToken = clientToken   
            };

            var response = await Http.PostAsJsonAsync("/api/sessions/join-jam", joinRequest);

            if (response.IsSuccessStatusCode)
            {
                Logger.LogInformation("Successfully joined session {id}", session.Id);
                Navigation.NavigateTo($"/session/{session.Id}");
            }
            else
            {
                var text = await response.Content.ReadAsStringAsync();
                if (text.Contains("Session is full", StringComparison.OrdinalIgnoreCase))
                    errorMessage = "This session is full.";
                else if (text.Contains("Incorrect password", StringComparison.OrdinalIgnoreCase))
                    errorMessage = "Incorrect password.";
                else
                    errorMessage = "Failed to join.";

                _ = Task.Run(async () => { await Task.Delay(3000); errorMessage = null; await InvokeAsync(StateHasChanged); });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error joining session");
            errorMessage = "Unexpected error.";
        }
        finally
        {
            isJoining = false;
        }
    }

    private void CloseAlert() => errorMessage = null;
}

<script>
    (function () {
        if (!window.sessionAudioSync) {
            window.sessionAudioSync = {};
        }

        if (!window.sessionAudioSync.enableSync) {
            window.sessionAudioSync.enableSync = function () {
                try {
                    const a = new Audio();
                    a.muted = true;
                    const p = a.play();
                    if (p && p.then) {
                        p.then(() => {
                            a.pause();
                            a.currentTime = 0;
                            console.log("Autoplay unlocked on this tab (JoinJam)");
                        }).catch(err => {
                            console.warn("Cannot unlock autoplay", err);
                        });
                    }
                } catch (e) {
                    console.warn("enableSync error", e);
                }
            };
        }
    })();
</script>