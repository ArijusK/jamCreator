@rendermode InteractiveWebAssembly
@page "/profile"
@using System.ComponentModel.DataAnnotations
@using JamCreator.Shared.Models.DTOs
@inject IJSRuntime JS
@inject HttpClient Http

<h1>Your Profile</h1>

@if (hasProfile && !isEditing)
{
    <div class="profile-display" style="display:flex;align-items:center;gap:1rem;">
        <div class="avatar-large" style="font-size:48px;">@profile.Avatar</div>
        <div>
            <p><strong>Nickname:</strong> @profile.Username</p>
            <p><strong>Favorite Genre:</strong> @profile.FavoriteGenre</p>
            <div class="btn-group">
                <button class="btn btn-primary" @onclick="BeginEdit">Change</button>
                <button class="btn btn-danger" @onclick="DeleteProfile">Delete</button>
            </div>
        </div>
    </div>
}
else
{
    <EditForm Model="@profile" OnValidSubmit="@SaveProfile" FormName="profileForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="username">Nickname</label>
            <InputText id="username" class="form-control" @bind-Value="profile.Username" />
            <ValidationMessage For="@(() => profile.Username)" />
        </div>

        <div class="form-group">
            <label for="genre">Favorite Genre</label>
            <InputText id="genre" class="form-control" @bind-Value="profile.FavoriteGenre" />
        </div>

        <div class="form-group">
            <label>Select Avatar</label>
            <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
                @foreach (var a in availableAvatars)
                {
                    var selected = profile.Avatar == a;
                    <button type="button"
                            class="btn btn-light"
                            style="border:@(selected ? "2px solid #0d6efd" : "1px solid #ccc");font-size:24px;"
                            @onclick="() => SelectAvatar(a)">
                        @a
                    </button>
                }
            </div>
        </div>

        <div class="btn-group" style="margin-top:0.5rem;">
            <button type="submit" class="btn btn-success" disabled="@saving">Save</button>
            <button type="button" class="btn btn-secondary" @onclick="CancelEdit" disabled="@saving">Cancel</button>
        </div>
    </EditForm>
}

@if (showSavedMessage)
{
    <p class="text-success" style="margin-top:0.5rem;">Profile saved successfully</p>
}
@if (!string.IsNullOrEmpty(error))
{
    <p class="text-danger" style="margin-top:0.5rem;">@error</p>
}

@code {
    public class UserProfileVm
    {
        [Required(ErrorMessage = "Nickname is required")]
        public string Username { get; set; } = string.Empty;
        public string FavoriteGenre { get; set; } = string.Empty;
        public string Avatar { get; set; } = "🎸";
    }

    private UserProfileVm profile = new();
    private bool hasProfile;
    private bool isEditing = true;
    private bool showSavedMessage;
    private bool saving;
    private string? error;

    private string clientId = string.Empty;

    private readonly List<string> availableAvatars = new()
    {
        "🎸","🎧","🎹","🥁","🎤","🪕","🎻","🪗","😎","🤘"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        clientId = await JS.InvokeAsync<string>("localStorage.getItem", "profile.clientId");
        if (string.IsNullOrWhiteSpace(clientId))
        {
            clientId = Guid.NewGuid().ToString("N");
            await JS.InvokeVoidAsync("localStorage.setItem", "profile.clientId", clientId);
        }
        try
        {
            var dto = await Http.GetFromJsonAsync<UserProfileDto>($"/api/profile/{clientId}");
            if (dto is not null)
            {
                profile.Username = dto.Username;
                profile.FavoriteGenre = dto.FavoriteGenre;
                profile.Avatar = string.IsNullOrWhiteSpace(dto.Avatar) ? availableAvatars.First() : dto.Avatar;
                hasProfile = true;
                isEditing = false;
            }
            else
            {
                var username = await JS.InvokeAsync<string>("localStorage.getItem", "chat.username");
                var genre = await JS.InvokeAsync<string>("localStorage.getItem", "genre");
                var avatar = await JS.InvokeAsync<string>("localStorage.getItem", "avatar");

                profile.Username = username ?? "";
                profile.FavoriteGenre = genre ?? "";
                profile.Avatar = string.IsNullOrWhiteSpace(avatar) ? availableAvatars.First() : avatar;

                hasProfile = !string.IsNullOrWhiteSpace(profile.Username);
                isEditing = !hasProfile;
            }
        }
        catch
        {
            var username = await JS.InvokeAsync<string>("localStorage.getItem", "chat.username");
            var genre = await JS.InvokeAsync<string>("localStorage.getItem", "genre");
            var avatar = await JS.InvokeAsync<string>("localStorage.getItem", "avatar");

            await JS.InvokeVoidAsync("sessionStorage.setItem", "jam.displayName", profile.Username);

            profile.Username = username ?? "";
            profile.FavoriteGenre = genre ?? "";
            profile.Avatar = string.IsNullOrWhiteSpace(avatar) ? availableAvatars.First() : avatar;

            hasProfile = !string.IsNullOrWhiteSpace(profile.Username);
            isEditing = !hasProfile;
        }

        StateHasChanged();
    }

    private async Task SaveProfile()
    {
        error = null;
        saving = true;
        StateHasChanged();

        var dto = new UserProfileDto
        {
            Id = clientId,
            Username = profile.Username,
            FavoriteGenre = profile.FavoriteGenre,
            Avatar = profile.Avatar
        };

        try
        {
            var resp = await Http.PutAsJsonAsync($"/api/profile/{clientId}", dto);
            resp.EnsureSuccessStatusCode();
            
            await JS.InvokeVoidAsync("localStorage.setItem", "chat.username", profile.Username);
            await JS.InvokeVoidAsync("localStorage.setItem", "genre", profile.FavoriteGenre);
            await JS.InvokeVoidAsync("localStorage.setItem", "avatar", profile.Avatar);

            hasProfile = true;
            isEditing = false;
            showSavedMessage = true;
            StateHasChanged();
            await Task.Delay(2000);
            showSavedMessage = false;
        }
        catch (Exception ex)
        {
            error = "Failed to save profile. " + ex.Message;
        }
        finally
        {
            saving = false;
            StateHasChanged();
        }
    }

    private void BeginEdit() => isEditing = true;

    private async Task DeleteProfile()
    {
        error = null;
        try
        {
            var resp = await Http.DeleteAsync($"/api/profile/{clientId}");
            if (!resp.IsSuccessStatusCode && resp.StatusCode != System.Net.HttpStatusCode.NotFound)
                error = $"Delete failed: {(int)resp.StatusCode}";

            await JS.InvokeVoidAsync("localStorage.removeItem", "chat.username");
            await JS.InvokeVoidAsync("localStorage.removeItem", "genre");
            await JS.InvokeVoidAsync("localStorage.removeItem", "avatar");

            profile = new UserProfileVm { Avatar = availableAvatars.First() };
            hasProfile = false;
            isEditing = true;
        }
        catch (Exception ex)
        {
            error = "Failed to delete profile. " + ex.Message;
        }
    }

    private void CancelEdit()
    {
        if (hasProfile)
            isEditing = false;
        else
            profile = new UserProfileVm { Avatar = availableAvatars.First() };
    }

    private void SelectAvatar(string a) => profile.Avatar = a;
}
