@page "/session/{SessionId}"
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@using JamCreator.Shared.Models.DTOs
@using JamCreator.Shared.Models
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components

@if (session is null)
{
    <div class="container mt-4">
        <p><em>Loading session...</em></p>
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p class="text-danger mt-2">@errorMessage</p>
        }
    </div>
}
else
{
    <div class="container mt-4">
        <!-- Room Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="mb-1">@session.RoomName</h3>
                <div class="text-muted">
                    @if (!string.IsNullOrWhiteSpace(session.Genre))
                    {
                        <span class="me-2">
                            <strong>Genre:</strong> @session.Genre
                        </span>
                    }

                    @if (session.Mood is not null)
                    {
                        <span class="me-2">
                            <strong>Mood:</strong> @session.Mood
                        </span>
                    }

                    @if (session.DurationMinutes is not null)
                    {
                        <span class="me-2">
                            <strong>Duration:</strong> @session.DurationMinutes minutes
                        </span>
                    }

                    <span class="me-2">
                        <strong>Created:</strong> @session.CreatedAtUtc.ToLocalTime().ToString("g")
                    </span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="ShowRoomInfo">
                    Room info
                </button>

                <button class="btn btn-outline-danger btn-sm" @onclick="LeaveSession" disabled="@isLeaving">
                    @(isLeaving ? "Leaving..." : "Leave Session")
                </button>

                <button class="btn btn-danger" @onclick="DeleteSession" disabled="@isDeleting">
                    @(isDeleting ? "Deleting..." : "Delete Session")
                </button>
            </div>
        </div>

        <!-- Room Info Modal -->
        @if (showInfo)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <h5 class="alert-heading">Room details</h5>
                <p>
                    @if (!string.IsNullOrWhiteSpace(session.Description))
                    {
                        @session.Description
                    }
                    else
                    {
                        <em>No additional description.</em>
                    }
                </p>
                <hr />
                <p class="mb-0">
                    <strong>Privacy:</strong> @(session.IsPrivate ? "Private" : "Public")<br />
                    <strong>Allow skip vote:</strong> @(session.AllowSkipVote ? "Yes" : "No")<br />
                    <strong>Max participants:</strong> @(session.MaxPeople?.ToString() ?? "Unlimited")
                </p>

                <button type="button" class="btn-close" aria-label="Close" @onclick="HideRoomInfo"></button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger mt-3" role="alert">
                @errorMessage
            </div>
        }

        <!-- Playlist -->
        <h5 class="mt-4 mb-2">Playlist</h5>

        @if (tracks.Any())
        {
            <p class="text-muted">
                <i>Only one track plays at a time (synchronized between participants).</i>
            </p>

            @for (var i = 0; i < tracks.Count; i++)
            {
                var t = tracks[i];
                var key = t.Id.ToString();

                <div class="card-body">
                    <p class="fw-bold mb-2">@t.Title</p>

                    <audio class="jam-audio"
                           controls
                           style="width:100%;"
                           @ref="audioRefs[i]"
                           @onplay="@(async () => await OnLocalTrackPlayAsync(key))"
                           @onpause="@(async () => await OnLocalTrackPauseAsync(key))">
                        <source src="@BuildTrackUrl(t)" type="audio/mpeg" />
                    </audio>
                </div>
            }
        }
        else
        {
            <p class="text-muted"><i>No tracks available.</i></p>
        }

        <!-- Participants -->
        <h5 class="mt-4 mb-3">Participants</h5>

        <div class="card shadow-sm p-3 mb-4" style="max-width: 320px;">
            <div class="d-flex justify-content-between mb-3">
                <span>Online</span>
                <span class="badge bg-primary">
                    @($"{participants?.Count ?? 0} / {session.MaxPeople?.ToString() ?? "?"}")
                </span>
            </div>

            @if (participants is null)
            {
                <div class="text-muted"><em>Loading...</em></div>
            }
            else if (participants.Count == 0)
            {
                <div class="text-muted"><em>No one here yet.</em></div>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var p in participants)
                    {
                        <li class="d-flex align-items-center mb-1">
                            <span class="badge rounded-pill bg-secondary me-2">🎧</span>
                            <span>@p</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}

@code {

    [Parameter] public string? SessionId { get; set; }

    private JamSessionDto? session;
    private List<AudioTrackDto> tracks = new();
    private bool isDeleting = false;
    private string? errorMessage;
    private bool audioInitDone = false;
    private List<string>? participants;
    private bool isLeaving = false;
    private bool showInfo = false;

    private HubConnection? playbackConnection;

    // Audio ref masyvas ir žemėlapis trackId -> indeksas
    private ElementReference[] audioRefs = Array.Empty<ElementReference>();
    private readonly Dictionary<string, int> trackIndexById = new();

    void ShowRoomInfo() => showInfo = true;
    void HideRoomInfo() => showInfo = false;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(SessionId))
            return;

        try
        {
            session = await Http.GetFromJsonAsync<JamSessionDto>(
                $"api/sessions/get-session-id/{SessionId}");

            if (session?.Tracks is not null && session.Tracks.Any())
            {
                tracks = session.Tracks.ToList();

                // paruošiam indeksus ir ref masyvą
                trackIndexById.Clear();
                for (int i = 0; i < tracks.Count; i++)
                {
                    trackIndexById[tracks[i].Id.ToString()] = i;
                }

                audioRefs = new ElementReference[tracks.Count];
            }
            else
            {
                tracks.Clear();
                trackIndexById.Clear();
                audioRefs = Array.Empty<ElementReference>();
            }

            participants = await Http.GetFromJsonAsync<List<string>>(
                $"api/sessions/{SessionId}/participants"
            ) ?? new List<string>();
        }
        catch
        {
            errorMessage = "Failed to load session.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // prisijungiame prie sinchroninio grojimo hub'o
        if (firstRender)
        {
            await EnsurePlaybackConnectionAsync();
        }

        // Inicijuojam JS tik kai jau turim trekų ir dar neinicijavom
        if (!audioInitDone && tracks.Any())
        {
            audioInitDone = true;
            await JS.InvokeVoidAsync("audioExclusiveInit");
        }
    }

    private async Task EnsurePlaybackConnectionAsync()
    {
        if (playbackConnection is not null || string.IsNullOrWhiteSpace(SessionId))
            return;

        playbackConnection = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/playbackhub"))
            .WithAutomaticReconnect()
            .Build();

        playbackConnection.On<PlaybackStateDto>(
            "PlaybackChanged",
            async dto =>
            {
                await HandlePlaybackChangedAsync(dto);
            });

        await playbackConnection.StartAsync();
        await playbackConnection.InvokeAsync("JoinSession", SessionId);
    }

    private async Task OnLocalTrackPlayAsync(string trackKey)
    {
        if (playbackConnection is null || string.IsNullOrWhiteSpace(SessionId))
            return;

        if (!trackIndexById.TryGetValue(trackKey, out var index))
            return;

        if (index < 0 || index >= audioRefs.Length)
            return;

        var audioRef = audioRefs[index];

        var positionSeconds = await JS.InvokeAsync<double>("getTrackCurrentTime", audioRef);

        await playbackConnection.InvokeAsync("Play", SessionId, trackKey, positionSeconds);
    }

    private async Task OnLocalTrackPauseAsync(string trackKey)
    {
        if (playbackConnection is null || string.IsNullOrWhiteSpace(SessionId))
            return;

        if (!trackIndexById.TryGetValue(trackKey, out var index))
            return;

        if (index < 0 || index >= audioRefs.Length)
            return;

        var audioRef = audioRefs[index];

        var positionSeconds = await JS.InvokeAsync<double>("getTrackCurrentTime", audioRef);

        await playbackConnection.InvokeAsync("Pause", SessionId, positionSeconds);
    }

    private async Task HandlePlaybackChangedAsync(PlaybackStateDto dto)
    {
        if (dto is null)
            return;

        var currentSessionId = SessionId;
        if (string.IsNullOrWhiteSpace(currentSessionId))
            return;

        // Įsitikiname, kad pakeitimas priklauso šiam kambariui
        if (!dto.SessionId.ToString().Equals(currentSessionId, StringComparison.OrdinalIgnoreCase))
            return;

        var trackKey = dto.TrackId.ToString();

        if (!trackIndexById.TryGetValue(trackKey, out var index))
            return;

        if (index < 0 || index >= audioRefs.Length)
            return;

        var audioRef = audioRefs[index];

        // Perduodame būseną į JS, kuris pajudina <audio>
        await JS.InvokeVoidAsync("syncTrackPlayback", audioRef, dto.Status.ToString(), dto.PositionSeconds);
    }

    private string BuildTrackUrl(AudioTrackDto track)
        => $"api/sessions/play-audio/{track.Mood.ToString().ToLower()}/{track.FileName}";

    private async Task DeleteSession()
    {
        if (session is null)
            return;

        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Delete “{session.RoomName}”?");
        if (!confirm) return;

        isDeleting = true;
        errorMessage = null;

        try
        {
            var resp = await Http.DeleteAsync($"api/sessions/delete-session/{session.Id}");
            if (resp.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/join-jam");
            }
            else
            {
                errorMessage = "Failed to delete session.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

        isDeleting = false;
    }

    private async Task LeaveSession()
    {
        if (session is null || string.IsNullOrWhiteSpace(SessionId))
            return;

        isLeaving = true;
        errorMessage = null;

        try
        {
            var displayName = await JS.InvokeAsync<string>("sessionStorage.getItem", "jam.displayName");
            if (string.IsNullOrWhiteSpace(displayName))
                displayName = "Guest";

            var clientToken = await JS.InvokeAsync<string>("localStorage.getItem", "jamClientToken");

            var req = new LeaveJamModel
            {
                SessionId = SessionId,
                DisplayName = displayName,
                ClientToken = clientToken
            };

            var resp = await Http.PostAsJsonAsync("api/sessions/leave-jam", req);

            if (!resp.IsSuccessStatusCode)
            {
                Console.WriteLine("leave-jam failed, status: " + resp.StatusCode);
            }

            Nav.NavigateTo("/join-jam");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to leave session: " + ex.Message;
        }
        finally
        {
            isLeaving = false;
        }
    }
}

<script>
    // Leidžiam tik vieną audio vienu metu.
    window.audioExclusiveInit = () => {
        const audios = document.querySelectorAll('.jam-audio');
        if (!audios.length) return;

        audios.forEach(a => {
            a.addEventListener('play', () => {
                audios.forEach(b => {
                    if (b !== a && !b.paused) {
                        b.pause();
                        b.currentTime = 0;
                    }
                });
            });
        });

        console.log("audioExclusiveInit: wired", audios.length, "players");
    };

    // Grąžina dabartinę nurodyto audio elemento grojimo poziciją (sekundėmis)
    window.getTrackCurrentTime = (audioElement) => {
        if (!audioElement) return 0;
        return audioElement.currentTime || 0;
    };

    // Pritaiko iš serverio gautą grojimo būseną konkrečiam audio elementui
    window.syncTrackPlayback = (audioElement, status, positionSeconds) => {
        if (!audioElement) return;

        if (typeof positionSeconds === 'number' && !isNaN(positionSeconds)) {
            audioElement.currentTime = positionSeconds;
        }

        if (status === 'Playing') {
            audioElement.play();
        } else if (status === 'Paused') {
            audioElement.pause();
        } else if (status === 'Stopped') {
            audioElement.pause();
            audioElement.currentTime = 0;
        }
    };
</script>
