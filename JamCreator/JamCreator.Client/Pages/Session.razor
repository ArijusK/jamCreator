@page "/session/{SessionId}"
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@using JamCreator.Shared.Models.DTOs
@using JamCreator.Shared.Models
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@implements IAsyncDisposable

@if (session is null)
{
    <div class="container mt-4">
        <p><em>Loading session...</em></p>
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p class="text-danger mt-2">@errorMessage</p>
        }
    </div>
}
else
{
    <div class="container mt-4 session-page">

        <!-- ROOM HEADER -->
        <div class="d-flex align-items-center mb-3">
            <h3 class="me-3 mb-0">JAM SESSION: @session.RoomName</h3>

            <button class="btn btn-outline-info p-0 px-1"
                    style="font-size:14px;height:22px;"
                    @onclick="ShowRoomInfo">
                <i class="bi bi-info-circle"></i>
            </button>
        </div>

        <!-- ROOM INFO MODAL -->
        @if (showInfo)
        {
            <div class="alert alert-light border shadow-sm p-3 mb-4">
                <p><b>Genre:</b> @session.Genre</p>
                <p><b>Mood:</b> @session.Mood</p>
                <p><b>Max People:</b> @session.MaxPeople</p>
                <p><b>Private:</b> @(session.IsPrivate ? "Yes" : "No")</p>
                <p><b>Description:</b> @session.Description</p>

                <button class="btn btn-sm btn-secondary" @onclick="HideRoomInfo">
                    Close
                </button>
            </div>
        }

        <h5>Upload Custom Track, Only .mp3 files</h5>

        <InputFile OnChange="OnFileSelected" accept=".mp3" />

        @if (selectedFileName is not null)
        {
            <p><b>Selected:</b> @selectedFileName</p>
        }

        <button class="btn btn-primary" @onclick="UploadTrack" disabled="@(!isFileSelected)"> 
            @(isUploading ? "Uploading..." : "Upload Track")
        </button>

        <p style="color:red">@uploadError</p>


        <!-- DVIEJŲ KOLONŲ LAYOUTAS -->
        <div class="session-layout">
            
            <!-- KAIRĖ: playlist + participants + mygtukai -->
            <div class="session-left">

                <!-- PLAYLIST -->
                <h5 class="mt-4 mb-2">Playlist</h5>

                @if (tracks.Any())
                {
                    <p class="text-muted"><i>Only one track plays at a time.</i></p>

                    @foreach (var t in tracks)
                    {
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <p class="fw-bold mb-1">@t.Title</p>
                                <audio class="jam-audio"
                                       controls
                                       style="width:300px;"
                                       data-track-key="@t.Id">
                                    <source src="@BuildTrackUrl(t)" type="audio/mpeg" />
                                </audio>
                            </div>

                            @if(t.IsCustom)
                            {
                                <button class="btn btn-outline-danger btn-sm p-1"
                                        style="border-radius: 50%;"
                                        @onclick="() => DeleteTrack(t)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted"><i>No tracks available.</i></p>
                }

                <!-- PARTICIPANTS -->
                <h5 class="mt-4 mb-3">Participants</h5>

<div class="card shadow-sm mb-4" style="max-width: 320px; border: 1px solid #198754;">
    
    <div class="card-header bg-success text-white py-2">
        <div class="d-flex justify-content-between align-items-center">
            <span class="fw-bold">
                <i class="bi bi-people-fill me-2"></i>Online Users
            </span>
            <span class="badge bg-white text-success rounded-pill">
                @(session?.Participants?.Count ?? 0) / @(session?.MaxPeople?.ToString() ?? "?")
            </span>
        </div>
    </div>

    <div class="card-body p-0" style="height: 250px; overflow-y: auto; background-color: #f8f9fa;">
        @if (session?.Participants != null && session.Participants.Any())
        {
            <ul class="list-group list-group-flush">
                @foreach (var participant in session.Participants)
                {
                    <li class="list-group-item d-flex align-items-center justify-content-between border-bottom-0 border-top-0" style="background-color: transparent;">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-white border border-success d-flex justify-content-center align-items-center me-2 text-success" 
                                 style="width: 32px; height: 32px; font-weight:bold; font-size: 0.8rem;">
                                @(string.IsNullOrEmpty(participant.DisplayName) ? "?" : participant.DisplayName.Substring(0, 1).ToUpper())
                            </div>
                            <span class="fw-normal">@participant.DisplayName</span>
                        </div>
                        <span style="height: 10px; width: 10px; background-color: #28a745; border-radius: 50%; box-shadow: 0 0 5px #28a745;" title="Online"></span>
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                <i class="bi bi-emoji-frown fs-4"></i>
                <p class="mb-0 small mt-1">Room is empty.</p>
            </div>
        }
    </div>
    
    <div class="card-footer bg-white text-center py-1">
        <small class="text-success" style="font-size: 0.75rem;">Create Jam &bull; Live</small>
    </div>
</div>

                <!-- ACTION BUTTONS -->
                <div class="text-center mt-4">
                    <button class="btn btn-secondary me-2"
                            @onclick="LeaveSession"
                            disabled="@isLeaving">
                        @(isLeaving ? "Leaving..." : "Leave Session")
                    </button>

                    <button class="btn btn-danger"
                            @onclick="DeleteSession"
                            disabled="@isDeleting">
                        @(isDeleting ? "Deleting..." : "Delete Session")
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <p class="text-danger text-center mt-2">@errorMessage</p>
                }
            </div>

            <!-- DEŠINĖ: CHAT -->
            <div class="session-right">
                <Chat SessionId="@SessionId" />
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? SessionId { get; set; }

    private JamSessionDto? session;
    private List<AudioTrackDto> tracks = new();
    private bool isDeleting = false;
    private string? errorMessage;
    private bool audioInitDone = false;
    private List<string>? participants;
    private bool isLeaving = false;
    private bool showInfo = false;
    private IBrowserFile? selectedFile;
    private bool isFileSelected = false;
    private string? selectedFileName = null;
    private bool isUploading = false;
    private string? uploadError;
    private HubConnection? musicHub;
    private bool hubInitialized;
    private DotNetObjectReference<Session>? dotNetRef;
    private bool autoRefreshRunning;
    private CancellationTokenSource? refreshCts;
    private int lastTrackCount;
    private bool sessionDeleted;     
    private bool redirectScheduled;   



    void ShowRoomInfo() => showInfo = true;
    void HideRoomInfo() => showInfo = false;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(SessionId))
            return;

        try
        {
            session = await Http.GetFromJsonAsync<JamSessionDto>(
                $"api/sessions/get-session-id/{SessionId}");

            if (session?.Tracks is not null && session.Tracks.Any())
            {
                tracks = session.Tracks.ToList();
            }
            else
            {
                tracks.Clear();
            }

            participants = await Http.GetFromJsonAsync<List<string>>(
                $"api/sessions/{SessionId}/participants"
            ) ?? new List<string>();
        }
        catch
        {
            errorMessage = "Failed to load session.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (sessionDeleted && !redirectScheduled)
        {
            redirectScheduled = true;
            Nav.NavigateTo("/join-jam");
            return;
        }
        if (firstRender)
        {
            await StartAutoRefreshAsync();
        }

        // 🔹 Audio ir sync JS inicijuojam tik kai jau yra trekų DOM'e
        if (!audioInitDone && tracks.Any())
        {
            audioInitDone = true;
            await JS.InvokeVoidAsync("audioExclusiveInit");

            dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("sessionAudioSync.init", dotNetRef);
        }

        // 🔹 Hubą kuriam tik kartą
        if (firstRender && !hubInitialized && !string.IsNullOrWhiteSpace(SessionId))
        {
            hubInitialized = true;

            if (musicHub is null)
            {
                musicHub = new HubConnectionBuilder()
                    .WithUrl(Nav.ToAbsoluteUri("/musichub"))
                    .WithAutomaticReconnect()
                    .Build();

                musicHub.On<string, double>("PlayTrack", async (trackKey, positionSeconds) =>
                {
                    await JS.InvokeVoidAsync("sessionAudioSync.playRemote", trackKey, positionSeconds);
                });
                musicHub.On<string, double>("PauseTrack", async (trackKey, positionSeconds) =>
                {
                    await JS.InvokeVoidAsync("sessionAudioSync.pauseRemote", trackKey, positionSeconds);
                });

                await musicHub.StartAsync();
                await musicHub.SendAsync("JoinSessionGroup", SessionId);
            }
        }
    }

    [JSInvokable]
    public async Task NotifyTrackPlayed(string trackKey, double positionSeconds)
    {
        if (musicHub is null || string.IsNullOrWhiteSpace(SessionId))
            return;

        await musicHub.SendAsync(
            "BroadcastPlayTrack",
            SessionId,
            trackKey,
            positionSeconds
        );
    }

    [JSInvokable]
    public async Task NotifyTrackPaused(string trackKey, double positionSeconds)
    {
        if (musicHub is null || string.IsNullOrWhiteSpace(SessionId))
            return;

        await musicHub.SendAsync(
            "BroadcastPauseTrack",
            SessionId,
            trackKey,
            positionSeconds
        );
    }

    private string BuildTrackUrl(AudioTrackDto track)
    {
        if (track.IsCustom)
        {
            return $"/api/sessions/play-audio/custom/{Uri.EscapeDataString(track.FileName)}";
        }

        return $"/api/sessions/play-audio/{track.Mood.ToString().ToLower()}/{Uri.EscapeDataString(track.FileName)}";
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        isFileSelected = selectedFile != null;
        selectedFileName = selectedFile?.Name;
    }

    private async Task UploadTrack()
    {
        uploadError = null;
        if (selectedFile is null)
        {
            uploadError = "No file selected!";
            return;
        }

        try
        {
            isUploading = true;

            using var content = new MultipartFormDataContent();
            var stream = selectedFile.OpenReadStream(50 * 1024 * 1024); // 50MB
            var fileContent = new StreamContent(stream);

            fileContent.Headers.ContentType =
                new System.Net.Http.Headers.MediaTypeHeaderValue(selectedFile.ContentType);

            content.Add(fileContent, "file", selectedFile.Name);

            var resp = await Http.PostAsync($"/api/sessions/{SessionId}/upload-track", content);

            if (resp.IsSuccessStatusCode)
            {
                var updated = await Http.GetFromJsonAsync<JamSessionDto>($"/api/sessions/get-session-id/{SessionId}");
                session = updated;
                tracks = updated?.Tracks?.ToList() ?? new();
            }
            else
            {
                uploadError = "Upload failed.";
            }
        }
        catch (Exception ex)
        {
            uploadError = ex.Message;
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task DeleteTrack(AudioTrackDto track)
    {
        if (track == null) return;

        var confirm = await JS.InvokeAsync<bool>("confirm",
            $"Delete track '{track.Title}'?");

        if (!confirm) return;

        var resp = await Http.DeleteAsync($"api/sessions/{track.Id}/delete-track");

        if (resp.IsSuccessStatusCode)
        {
            tracks.Remove(track);
            StateHasChanged();
        }
        else
        {
            var msg = await resp.Content.ReadAsStringAsync();
            Console.WriteLine("Delete failed: " + msg);
        }
    }

    private async Task DeleteSession()
    {
        if (session is null)
            return;

        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Delete “{session.RoomName}”?");
        if (!confirm) return;

        isDeleting = true;
        errorMessage = null;

        try
        {
            var resp = await Http.DeleteAsync($"api/sessions/delete-session/{session.Id}");
            if (resp.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/join-jam");
            }
            else
            {
                errorMessage = "Failed to delete session.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

        isDeleting = false;
    }

    private async Task LeaveSession()
    {
        if (session is null || string.IsNullOrWhiteSpace(SessionId))
            return;

        isLeaving = true;
        errorMessage = null;

        try
        {
            var displayName = await JS.InvokeAsync<string>("sessionStorage.getItem", "jam.displayName");
            if (string.IsNullOrWhiteSpace(displayName))
                displayName = "Guest";

            var clientToken = await JS.InvokeAsync<string>("localStorage.getItem", "jamClientToken");

            var req = new LeaveJamModel
            {
                SessionId = SessionId,
                DisplayName = displayName,
                ClientToken = clientToken
            };

            var resp = await Http.PostAsJsonAsync("api/sessions/leave-jam", req);

            if (!resp.IsSuccessStatusCode)
            {
                Console.WriteLine("leave-jam failed, status: " + resp.StatusCode);
            }

            Nav.NavigateTo("/join-jam");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to leave session: " + ex.Message;
        }
        finally
        {
            isLeaving = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        refreshCts?.Cancel();
        refreshCts?.Dispose();

        if (musicHub is not null)
        {
            try
            {
                if (!string.IsNullOrWhiteSpace(SessionId))
                {
                    await musicHub.SendAsync("LeaveSessionGroup", SessionId);
                }
                await musicHub.DisposeAsync();
            }
            catch
            {
            }
        }

        dotNetRef?.Dispose();
    }

    private async Task StartAutoRefreshAsync()
    {
        if (autoRefreshRunning || string.IsNullOrWhiteSpace(SessionId))
            return;

        autoRefreshRunning = true;
        refreshCts = new CancellationTokenSource();
        var token = refreshCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                while (!token.IsCancellationRequested)
                {
                    try
                    {
                        await Task.Delay(TimeSpan.FromSeconds(2), token);
                    }
                    catch (TaskCanceledException)
                    {
                        break;
                    }

                    await RefreshSessionDataAsync();
                    await InvokeAsync(StateHasChanged);
                }
            }
            finally
            {
                autoRefreshRunning = false;
            }
        });
    }

    private async Task RefreshSessionDataAsync()
    {
        if (string.IsNullOrWhiteSpace(SessionId))
            return;

        try
        {
            var updated = await Http.GetFromJsonAsync<JamSessionDto>($"api/sessions/get-session-id/{SessionId}");
            if (updated != null)
            {
                session = updated;

                var newTracks = updated.Tracks?.ToList() ?? new List<AudioTrackDto>();
                if (newTracks.Count != lastTrackCount)
                {
                    tracks = newTracks;
                    lastTrackCount = tracks.Count;
                    audioInitDone = false;
                }
                else
                {
                    tracks = newTracks;
                }
            }

            participants = await Http.GetFromJsonAsync<List<string>>(
                $"api/sessions/{SessionId}/participants") ?? new List<string>();
        }
        catch
        {
            sessionDeleted = true;

            session = null;
            tracks.Clear();
            participants = new List<string>();
            errorMessage = "Failed to load session.";
        }
    }


}

<script>
    // Leidžiam tik vieną audio vienu metu.
    window.audioExclusiveInit = () => {
        const audios = document.querySelectorAll('.jam-audio');
        if (!audios.length) return;

        audios.forEach(a => {
            a.addEventListener('play', () => {
                audios.forEach(b => {
                    if (b !== a && !b.paused) {
                        b.pause();
                        b.currentTime = 0;
                    }
                });
            });
        });

        console.log("audioExclusiveInit: wired", audios.length, "players");
    };
</script>

<script>
    // Sync tarp vartotojų: vienas paleidžia, kiti gauna PlayTrack per SignalR.
    (function () {
        const existing = window.sessionAudioSync || {};
        let dotNetRef = existing._dotNetRef || null;

        existing.init = function (dotNet) {
            dotNetRef = dotNet;
            existing._dotNetRef = dotNet;

            const audios = document.querySelectorAll('.jam-audio');
            audios.forEach(a => {
                a.addEventListener('play', () => {
                    const key = a.getAttribute('data-track-key') || '';
                    const pos = a.currentTime || 0;
                    if (dotNetRef && key) {
                        dotNetRef.invokeMethodAsync('NotifyTrackPlayed', key, pos);
                    }
                });
                a.addEventListener('pause', () => {
                    const key = a.getAttribute('data-track-key') || '';
                    const pos = a.currentTime || 0;
                    if (dotNetRef && key) {
                        dotNetRef.invokeMethodAsync('NotifyTrackPaused', key, pos);
                    }
                });
            });

            console.log("sessionAudioSync.init wired", audios.length, "players");
        };

        existing.playRemote = function (trackKey, position) {
            const audio = document.querySelector(`audio[data-track-key="${trackKey}"]`);
            if (!audio) {
                console.warn("sessionAudioSync.playRemote: audio not found for key", trackKey);
                return;
            }

            audio.currentTime = position || 0;
            const p = audio.play();
            if (p && p.catch) {
                p.catch(err => console.warn("sessionAudioSync.playRemote blocked", err));
            }
        };
        existing.pauseRemote = function (trackKey, position) {
            const audio = document.querySelector(`audio[data-track-key="${trackKey}"]`);
            if (!audio) {
                console.warn("sessionAudioSync.pauseRemote: audio not found for key", trackKey);
                return;
            }

            if (typeof position === "number") {
                audio.currentTime = position;
            }

            audio.pause();
        };

        // paliekam enableSync, jei buvo pridėtas JoinJam puslapyje
        window.sessionAudioSync = existing;
    })();
    window.showSessionDeletedModal = function () {
        var modalEl = document.getElementById('sessionDeletedModal');
        if (!modalEl) return;

        var modal = new bootstrap.Modal(modalEl);
        modal.show();
    };
</script>

<style>
    .session-layout {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 20px;
    }

    .session-left {
        width: 100%;
    }

    .session-right {
        position: sticky;
        top: 20px;
    }

    @@media (max-width: 768px) {
        .session-layout {
            grid-template-columns: 1fr;
        }

        .session-right {
            position: static;
            margin-top: 20px;
        }
    }
</style>
