@page "/session/{SessionId}"
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="session-container">
    <h3>Jam Session</h3>

    @if (session is null)
    {
        <p>Loading session...</p>
    }
    else
    {
        <ul>
            <li><b>Room:</b> @session.RoomName</li>
            <li><b>Genre:</b> @session.Genre</li>
            <li><b>Max People:</b> @session.MaxPeople</li>
            <li><b>Private:</b> @(session.IsPrivate ? "Yes" : "No")</li>
            <li><b>Mood:</b> @session.Mood</li>
            <li><b>Duration:</b> @session.DurationMinutes min</li>
        </ul>

        <h4>Now Playing</h4>
        <audio controls style="width:100%;max-width:420px">
            <source src="@AudioUrl" type="audio/mpeg" />
            Your browser does not support the audio element.
        </audio>

        <div style="margin: 20px auto; max-width: 900px; width: 100%;">
            <Chat SessionId="@SessionId" />
        </div>

        <div style="margin-top: 2rem; text-align: center;">
            <button class="btn btn-danger"
                    @onclick="DeleteSession"
                    disabled="@isDeleting">
                @(isDeleting ? "Deleting..." : "Delete Session")
            </button>
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <p style="color:red; margin-top:10px;">@errorMessage</p>
            }
        </div>
    }
</div>

<style>
    .session-container {
        max-width: 1000px;
        margin: 0 auto;
        text-align: center;
        padding: 20px;
    }

    ul {
        list-style-type: none;
        padding: 0;
        margin-bottom: 20px;
    }
    
    ul li {
        display: inline-block;
        margin: 0 10px;
        background: #1a2d1f;
        padding: 5px 10px;
        border-radius: 8px;
        font-size: 0.9rem;
    }
</style>

@code {
    [Parameter]
    public string? SessionId { get; set; }

    private JamSessionModel? session;
    private string? AudioUrl;
    private bool isDeleting = false;
    private string? errorMessage;
    private bool audioInitDone = false;
    private List<string>? participants;
    private bool isLeaving = false;
    private bool showInfo = false;

    void ShowRoomInfo() => showInfo = true;
    void HideRoomInfo() => showInfo = false;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(SessionId))
            return;

        try
        {
            session = await Http.GetFromJsonAsync<JamSessionDto>(
                $"api/sessions/get-session-id/{SessionId}");

            if (session != null)
            {
                tracks = session.Tracks.ToList();
            }
            else
            {
                tracks.Clear();
            }

            participants = await Http.GetFromJsonAsync<List<string>>(
                $"api/sessions/{SessionId}/participants"
            ) ?? new List<string>();
        }
        catch
        {
            errorMessage = "Failed to load session.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Inicijuojam JS tik kai jau turim trekų ir dar neinicijavom
        if (!audioInitDone && tracks.Any())
        {
            audioInitDone = true;
            await JS.InvokeVoidAsync("audioExclusiveInit");
        }
    }

    private string BuildTrackUrl(AudioTrackDto track)
        => $"api/sessions/play-audio/{track.Mood.ToString().ToLower()}/{track.FileName}";

    private async Task DeleteSession()
    {
        if (session is null)
            return;

        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Delete “{session.RoomName}”?");
        if (!confirm) return;

        isDeleting = true;
        errorMessage = null;

        try
        {
            var resp = await Http.DeleteAsync($"api/sessions/delete-session/{session.Id}");
            if (resp.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/join-jam"); 
            }
            else
            {
                errorMessage = "Failed to delete session.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

        isDeleting = false;
    }

    private async Task LeaveSession()
    {
        if (session is null || string.IsNullOrWhiteSpace(SessionId))
            return;

        isLeaving = true;
        errorMessage = null;

        try
        {
            var displayName = await JS.InvokeAsync<string>("sessionStorage.getItem", "jam.displayName");
            if (string.IsNullOrWhiteSpace(displayName))
                displayName = "Guest";

            var clientToken = await JS.InvokeAsync<string>("localStorage.getItem", "jamClientToken");

            var req = new LeaveJamModel
            {
                SessionId = SessionId,
                DisplayName = displayName,
                ClientToken = clientToken
            };

            var resp = await Http.PostAsJsonAsync("api/sessions/leave-jam", req);

            if (!resp.IsSuccessStatusCode)
            {
                Console.WriteLine("leave-jam failed, status: " + resp.StatusCode);
            }

            Nav.NavigateTo("/join-jam");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to leave session: " + ex.Message;
        }
        finally
        {
            isLeaving = false;
        }
    }
}
